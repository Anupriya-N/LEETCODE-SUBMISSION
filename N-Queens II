class Solution {
    private int count = 0;
    private int n;

    public int totalNQueens(int n) {
        this.n = n;
        backtrack(0, new boolean[n], new boolean[2 * n], new boolean[2 * n]);
        return count;
    }

    private void backtrack(int row, boolean[] columns, boolean[] diag1, boolean[] diag2) {
        if (row == n) {
            count++;
            return;
        }

        for (int col = 0; col < n; col++) {
            int d1 = row - col + n; 
            int d2 = row + col;

            if (columns[col] || diag1[d1] || diag2[d2]) {
                continue;
            }

            columns[col] = true;
            diag1[d1] = true;
            diag2[d2] = true;

            backtrack(row + 1, columns, diag1, diag2);

            columns[col] = false;
            diag1[d1] = false;
            diag2[d2] = false;
        }
    }
}
