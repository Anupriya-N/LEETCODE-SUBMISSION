import java.util.*;

class Solution {
    List<List<String>> results = new ArrayList<>();
    int n;

    public List<List<String>> solveNQueens(int n) {
        this.n = n;
        int[] queens = new int[n]; // queens[row] = col position
        Arrays.fill(queens, -1);

        backtrack(0, new HashSet<>(), new HashSet<>(), new HashSet<>(), queens);
        return results;
    }

    private void backtrack(int row, Set<Integer> columns, Set<Integer> diagonals1, Set<Integer> diagonals2, int[] queens) {
        if (row == n) {
            results.add(generateBoard(queens));
            return;
        }

        for (int col = 0; col < n; col++) {
            int diag1 = row - col;
            int diag2 = row + col;

            if (columns.contains(col) || diagonals1.contains(diag1) || diagonals2.contains(diag2)) {
                continue;
            }

            queens[row] = col;
            columns.add(col);
            diagonals1.add(diag1);
            diagonals2.add(diag2);

            backtrack(row + 1, columns, diagonals1, diagonals2, queens);

            // Backtrack
            queens[row] = -1;
            columns.remove(col);
            diagonals1.remove(diag1);
            diagonals2.remove(diag2);
        }
    }

    private List<String> generateBoard(int[] queens) {
        List<String> board = new ArrayList<>();
        for (int row = 0; row < n; row++) {
            char[] rowChars = new char[n];
            Arrays.fill(rowChars, '.');
            rowChars[queens[row]] = 'Q';
            board.add(new String(rowChars));
        }
        return board;
    }
}
